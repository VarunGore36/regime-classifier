   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from regime_classifier import (\n",
    "    BacktestEngine, SignalGenerator,\n",
    "    SyntheticDataLoader,\n",
    "    calculate_volume_profile, calculate_vwap,\n",
    "    calculate_realized_volatility, calculate_cvd,\n",
    "    detect_absorption, detect_exhaustion,\n",
    "    CombinedRegimeClassifier,\n",
    "    generate_report, create_tearsheet,\n",
    "    load_config\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Generate Synthetic Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create synthetic data loaders\n",
    "nq_loader = SyntheticDataLoader(\"NQ\", start_price=15000, volatility=0.01, drift=0.0001)\n",
    "qqq_loader = SyntheticDataLoader(\"QQQ\", start_price=350, volatility=0.01, drift=0.0001)\n",
    "\n",
    "start = pd.Timestamp(\"2024-01-01 09:30\", tz=\"America/New_York\")\n",
    "end = pd.Timestamp(\"2024-03-31 16:00\", tz=\"America/New_York\")\n",
    "\n",
    "nq_bars = nq_loader.load_bars(start, end, \"1min\")\n",
    "qqq_bars = qqq_loader.load_bars(start, end, \"1min\")\n",
    "\n",
    "print(f\"NQ bars: {len(nq_bars)}\")\n",
    "print(f\"QQQ bars: {len(qqq_bars)}\")\n",
    "print(f\"Date range: {nq_bars['timestamp'].min()} to {nq_bars['timestamp'].max()}\")\n",
    "\n",
    "# Create minimal synthetic options/footprint (empty for demo)\n",
    "options_chain = pd.DataFrame()\n",
    "footprint = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Feature Engineering Demo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Volume Profile\n",
    "vol_profile = calculate_volume_profile(nq_bars)\n",
    "print(f\"POC: {vol_profile.poc:.2f}\")\n",
    "print(f\"VAH: {vol_profile.vah:.2f}\")\n",
    "print(f\"VAL: {vol_profile.val:.2f}\")\n",
    "print(f\"HVN count: {len(vol_profile.hvns)}\")\n",
    "print(f\"LVN count: {len(vol_profile.lvns)}\")\n",
    "\n",
    "# VWAP\n",
    "vwap_result = calculate_vwap(nq_bars)\n",
    "print(f\"\\nVWAP (last): {vwap_result.vwap.iloc[-1]:.2f}\")\n",
    "print(f\"Upper 3σ: {vwap_result.upper_bands[3.0].iloc[-1]:.2f}\")\n",
    "print(f\"Lower 3σ: {vwap_result.lower_bands[3.0].iloc[-1]:.2f}\")\n",
    "\n",
    "# Realized Volatility\n",
    "rv_result = calculate_realized_volatility(nq_bars)\n",
    "print(f\"\\nRV (last): {rv_result.rv.iloc[-1]:.4f}\")\n",
    "print(f\"RV Z-Score: {rv_result.rv_zscore.iloc[-1]:.2f}\")\n",
    "print(f\"Regime: {rv_result.regime.iloc[-1]}\")"
   ]
