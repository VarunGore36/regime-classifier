# Environment variables for regime classifier

# Data paths (adjust to your data location)
NQ_DATA_PATH=data/nq_1min.parquet
QQQ_DATA_PATH=data/qqq_1min.parquet
OPTIONS_DATA_PATH=data/options_chain.parquet
FOOTPRINT_DATA_PATH=data/footprint.parquet

# API keys (if using data providers)
# DATABENTO_API_KEY=your_key_here
# CBOE_API_KEY=your_key_here

# Backtest settings
INITIAL_CAPITAL=100000
COMMISSION_PER_CONTRACT=2.50
SLIPPAGE_TICKS=1

# Timezone
TIMEZONE=America/New_York

# Logging
LOG_LEVEL=INFO